# ─── Core ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_-base64_32

# ─── Anthropic (AI extraction) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Server-only, never expose to client

# ─── Google OAuth (for Gmail + user auth) ─────────────────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ─── Baileys session storage ──────────────────────────────────────────────────
# Path where Baileys saves auth state files (.baileys_sessions/<userId>/)
# On Vercel: use /tmp (ephemeral) — production should use S3 or Supabase Storage
BAILEYS_SESSION_DIR=.baileys_sessions

# ─── Anti-ban tuning (optional overrides) ────────────────────────────────────
# ACTIVE_HOURS_START=8      # IST hour to start listening (default: 8)
# ACTIVE_HOURS_END=21       # IST hour to stop listening  (default: 21)
# MAX_MESSAGES_PER_MINUTE=30
